{
  "name": "dsh-bot",
  "version": "0.2.0",
  "icon": "./icon.svg",
  "description": "Persistent AI teammates, collaborative group chats and observable work inside DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./readonly": "./lib/readonly.js",
    "./host": "./lib/host-service.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "test",
    "scripts/build.mjs",
    "scripts/team-browser-smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs && node --test test/*.test.mjs",
    "test:browser": "node scripts/build.mjs && node scripts/team-browser-smoke.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZYX121212/dsh-bot.git"
  },
  "homepage": "https://github.com/ZYX121212/dsh-bot#readme",
  "bugs": {
    "url": "https://github.com/ZYX121212/dsh-bot/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
