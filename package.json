{
  "name": "dsh-bot",
  "version": "0.5.1",
  "icon": "./icon.svg",
  "description": "Persistent AI teammates, collaborative group chats and observable work inside DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./readonly": "./lib/readonly.js",
    "./host": "./lib/host-service.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "test",
    "scripts/build.mjs",
    "scripts/team-browser-smoke.mjs",
    "scripts/team-color-audit.mjs",
    "scripts/team-functional-audit.mjs",
    "scripts/team-history-audit.mjs",
    "scripts/team-record-audit.mjs",
    "scripts/team-gateway-fixture.mjs",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "docs/screenshots",
    "screenshots.json",
    "icon.svg",
    "icon.png"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs && node --test test/*.test.mjs",
    "test:browser": "node scripts/build.mjs && node scripts/team-browser-smoke.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT",
  "author": "ZYX121212",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-teammates",
    "group-chat",
    "persistent-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZYX121212/dsh-bot.git"
  },
  "homepage": "https://github.com/ZYX121212/dsh-bot#readme",
  "bugs": {
    "url": "https://github.com/ZYX121212/dsh-bot/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
